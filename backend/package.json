{
  "name": "olympic-school-backend",
  "private": true,
  "type": "module",
  "main": "functions/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "firebase:use": "npx -y firebase-tools@latest use",
    "deploy:auth": "npx -y firebase-tools@latest deploy --only auth --project biodoraia",
    "deploy:firestore": "npx -y firebase-tools@latest deploy --only firestore --project biodoraia",
    "teacher:set-claim": "node scripts/set-teacher-claim.mjs",
    "test": "node --test functions/*.test.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  }
}
