# Firebase Web SDK (valores públicos do app Web, não credenciais de servidor)
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=biodoraia.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=biodoraia
VITE_FIREBASE_STORAGE_BUCKET=biodoraia.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_FIRESTORE_DATABASE_ID=biodoraia

# App Check é ativado quando uma chave reCAPTCHA Enterprise válida é informada.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Modelo pode ser alterado sem editar o código.
VITE_GEMINI_MODEL=gemini-3.6-flash

# Use true somente para desenvolvimento offline explícito.
VITE_USE_MOCKS=false
