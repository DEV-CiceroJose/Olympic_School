{
  "name": "olympic-school-workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "js-yaml": "^4.3.2",
    "micromark-extension-math": {
      "katex": "0.18.10"
    },
    "nanoid": "^3.3.18",
    "rehype-katex": {
      "katex": "0.18.10"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace olympic-school-frontend",
    "build": "npm run build --workspace olympic-school-frontend",
    "build:dev": "npm run build:dev --workspace olympic-school-frontend",
    "preview": "npm run preview --workspace olympic-school-frontend",
    "lint": "npm run lint --workspace olympic-school-frontend",
    "test": "npm run test --workspace olympic-school-frontend",
    "format": "npm run format --workspace olympic-school-frontend",
    "firebase:use": "npm run firebase:use --workspace olympic-school-backend",
    "firebase:deploy:auth": "npm run deploy:auth --workspace olympic-school-backend",
    "firebase:deploy:firestore": "npm run deploy:firestore --workspace olympic-school-backend",
    "teacher:set-claim": "npm run teacher:set-claim --workspace olympic-school-backend --",
    "deploy:cloudflare": "npm run deploy:cloudflare --workspace olympic-school-frontend"
  }
}
