# Firebase Web SDK (valores públicos do app Web, não credenciais de servidor)
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=biodoraia.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=biodoraia
VITE_FIREBASE_STORAGE_BUCKET=biodoraia.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_FIRESTORE_DATABASE_ID=biodoraia

# Chave pública reCAPTCHA Enterprise usada pelo App Check antes de chamar o Gemini.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Gera um token de depuração no console do navegador, apenas em desenvolvimento local.
VITE_FIREBASE_APPCHECK_DEBUG=false

# Modelo pode ser alterado sem editar o código.
VITE_GEMINI_MODEL=gemini-3.6-flash

# URL do Cloudflare Worker do diagnóstico (opcional quando usar Cloud Functions).
VITE_ASSESSMENT_API_URL=https://olympic-school-diagnostic.olympic-school-biodoraia.workers.dev
